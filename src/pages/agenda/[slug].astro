---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const items = await getCollection('agenda');
  return items.map(item => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
const { Content } = await item.render();
const d = new Date(item.data.date);
---
<BaseLayout title={item.data.title}>
<article class="section">
  <span style="font-size:.72rem;letter-spacing:.15em;text-transform:uppercase;color:var(--ocre)">{item.data.type}</span>
  <h1 style="font-family:'Playfair Display',serif;font-size:2rem;color:var(--terre);margin:.75rem 0 1.5rem">{item.data.title}</h1>
  <div style="display:flex;gap:1.5rem;margin-bottom:2rem;flex-wrap:wrap">
    <span>📅 {d.toLocaleDateString('fr-FR',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}</span>
    <span>📍 {item.data.location}</span>
    <span>⏱ {item.data.duration}</span>
  </div>
  {item.data.registration_url && <a href={item.data.registration_url} target="_blank" rel="noopener" class="btn-primary" style="margin-bottom:2rem;display:inline-flex">S'inscrire →</a>}
  <div class="prose"><Content /></div>
</article>
</BaseLayout>
