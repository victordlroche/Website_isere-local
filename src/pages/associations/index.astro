---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('associations')).sort((a,b) => a.data.title.localeCompare(b.data.title));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Associations engagées" description="Associations du territoire isérois engagées pour le pisé et l'architecture de terre.">
<section class="section">
  <div class="section-header">
    <div><span class="section-eyebrow">Territoire</span><h2 class="section-title">Associations engagées</h2></div>
  </div>
  {items.length === 0 && <p style="color:var(--argile);font-size:.9rem">Aucune association pour le moment. Ajoutez-en via l'administration.</p>}
  <div class="grid">
    {items.map(a => (
      <div class="card">
        <div class="card-header">
          <div class="logo">{a.data.sigle}</div>
          <div><p class="name">{a.data.title}</p><span class="type">{a.data.type}</span></div>
        </div>
        <div class="infos">
          {a.data.address && <div class="row">📍 <span>{a.data.address}</span></div>}
          {a.data.phone && <div class="row">📞 <span>{a.data.phone}</span></div>}
          {a.data.email && <div class="row">✉️ <a href={`mailto:${a.data.email}`}>{a.data.email}</a></div>}
          {a.data.website && <div class="row">🌐 <a href={a.data.website} target="_blank" rel="noopener">{a.data.website.replace(/^https?:\/\//,'')}</a></div>}
        </div>
        <div class="card-foot">
          <span class="zone">📍 {a.data.zone}</span>
          <a href={`${base}/associations/${a.slug}`} class="cta">Fiche complète →</a>
        </div>
      </div>
    ))}
  </div>
</section>
</BaseLayout>
<style>
  .grid { display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem; }
  .card { background:white;border:.5px solid rgba(193,127,58,0.18);border-radius:1.25rem;overflow:hidden; }
  .card-header { padding:1.5rem 1.5rem 1rem;display:flex;align-items:flex-start;gap:1rem;border-bottom:.5px solid rgba(193,127,58,0.12); }
  .logo { width:3rem;height:3rem;border-radius:.75rem;background:var(--terre);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:.9rem;font-weight:600;color:var(--ocre-light);flex-shrink:0; }
  .name { font-family:'Playfair Display',serif;font-size:.95rem;font-weight:600;color:var(--charbon);line-height:1.3;margin-bottom:.3rem; }
  .type { font-size:.63rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ocre);background:var(--ocre-pale);padding:.2rem .6rem;border-radius:1rem; }
  .infos { padding:1rem 1.5rem;display:flex;flex-direction:column;gap:.45rem; }
  .row { display:flex;align-items:center;gap:.5rem;font-size:.76rem;color:var(--charbon); }
  .row a { color:var(--ocre);text-decoration:none; }
  .card-foot { padding:.75rem 1.5rem 1.25rem;display:flex;align-items:center;justify-content:space-between; }
  .zone { font-size:.65rem;letter-spacing:.08em;text-transform:uppercase;color:var(--argile);background:#F0E8D5;padding:.2rem .65rem;border-radius:1rem; }
  .cta { font-size:.7rem;color:var(--ocre);text-decoration:none;border-bottom:1px solid var(--ocre-light); }
  @media(max-width:768px){ .grid { grid-template-columns:1fr; } }
</style>
