---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const realisations = (await getCollection('realisations'))
  .filter(r => r.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const agenda = (await getCollection('agenda'))
  .filter(e => new Date(e.data.date) >= new Date())
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime())
  .slice(0, 3);

const associations = (await getCollection('associations')).slice(0, 3);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Pisé Isérois" description="Valoriser, transmettre et promouvoir le savoir-faire en construction de terre crue en Isère.">

<!-- HERO -->
<section class="hero">
  <div class="hero-text">
    <div class="eyebrow"><span class="eyebrow-line"></span>Savoir-faire vivant</div>
    <h1 class="hero-title">L'art du <em>pisé</em>,<br>patrimoine de l'Isère</h1>
    <p class="hero-subtitle">Valoriser, transmettre et promouvoir une technique de construction en terre crue façonnée depuis des siècles dans les vallées iséroises.</p>
    <div class="hero-actions">
      <a href="#pise" class="btn-primary">Découvrir le pisé <span class="btn-icon">↓</span></a>
      <a href={`${base}/realisations`} class="btn-ghost">Voir les réalisations →</a>
    </div>
    <div class="hero-stats">
      <div><span class="stat-num">8 000</span><span class="stat-label">Bâtiments en Isère</span></div>
      <div><span class="stat-num">XII<sup>e</sup></span><span class="stat-label">Siècle de tradition</span></div>
      <div><span class="stat-num">47</span><span class="stat-label">Artisans répertoriés</span></div>
    </div>
  </div>
  <div class="hero-visual">
    <img
      src="https://upload.wikimedia.org/wikipedia/commons/thumb/4/4e/Pise_construction.jpg/1200px-Pise_construction.jpg"
      alt="Mur en pisé en cours de construction"
      loading="eager"
      class="hero-img"
    />
    <div class="hero-overlay"></div>
    <div class="hero-badge"><span class="badge-num">100%</span><span class="badge-text">Terre locale</span></div>
  </div>
</section>

<!-- INTRO BAND -->
<div class="intro-band">
  <p class="intro-quote">« Le pisé n'est pas seulement une technique — c'est une relation intime entre l'homme, la terre et le territoire. »</p>
  <div class="intro-divider"></div>
  <p class="intro-text">Porté par un réseau d'artisans, d'architectes et de chercheurs passionnés, ce savoir-faire ancestral connaît aujourd'hui un renouveau exceptionnel, porté par les enjeux écologiques et le retour à des matériaux sains.</p>
</div>

<!-- SCHÉMA PÉDAGOGIQUE -->
<section class="schema-section" id="pise">
  <div class="section-header">
    <div>
      <span class="section-eyebrow">Comprendre</span>
      <h2 class="section-title">Qu'est-ce que le pisé ?</h2>
    </div>
    <a href={`${base}/le-pise`} class="section-link">En savoir plus →</a>
  </div>

  <!-- Coupe de mur -->
  <p class="bloc-titre">Coupe d'un mur en pisé</p>
  <div class="mur-wrapper">
    <svg width="215" height="284" viewBox="0 0 215 284" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Coupe transversale d'un mur en pisé"><title>Coupe d'un mur en pisé</title><rect x="22" y="12" width="172" height="22" rx="3" fill="#9E7B55"/><text x="108" y="27" text-anchor="middle" font-family="DM Sans,sans-serif" font-size="9" fill="#F7F2E8">Solin / débord de toit</text><rect x="22" y="36" width="172" height="34" fill="#C4A97A"/><line x1="22" y1="44" x2="194" y2="44" stroke="rgba(122,79,46,0.18)" stroke-width=".8" stroke-dasharray="4,3"/><line x1="22" y1="54" x2="194" y2="54" stroke="rgba(122,79,46,0.18)" stroke-width=".8" stroke-dasharray="4,3"/><line x1="22" y1="62" x2="194" y2="62" stroke="rgba(122,79,46,0.18)" stroke-width=".8" stroke-dasharray="4,3"/><text x="108" y="57" text-anchor="middle" font-family="DM Sans,sans-serif" font-size="8.5" fill="#4A3220" font-weight="500">Assise damée</text><rect x="22" y="72" width="172" height="34" fill="#B89060"/><line x1="22" y1="80" x2="194" y2="80" stroke="rgba(122,79,46,0.18)" stroke-width=".8" stroke-dasharray="4,3"/><line x1="22" y1="90" x2="194" y2="90" stroke="rgba(122,79,46,0.18)" stroke-width=".8" stroke-dasharray="4,3"/><line x1="22" y1="98" x2="194" y2="98" stroke="rgba(122,79,46,0.18)" stroke-width=".8" stroke-dasharray="4,3"/><text x="108" y="93" text-anchor="middle" font-family="DM Sans,sans-serif" font-size="8.5" fill="#4A3220" font-weight="500">Assise damée</text><rect x="22" y="108" width="172" height="34" fill="#C4A97A"/><line x1="22" y1="116" x2="194" y2="116" stroke="rgba(122,79,46,0.18)" stroke-width=".8" stroke-dasharray="4,3"/><line x1="22" y1="126" x2="194" y2="126" stroke="rgba(122,79,46,0.18)" stroke-width=".8" stroke-dasharray="4,3"/><line x1="22" y1="134" x2="194" y2="134" stroke="rgba(122,79,46,0.18)" stroke-width=".8" stroke-dasharray="4,3"/><text x="108" y="129" text-anchor="middle" font-family="DM Sans,sans-serif" font-size="8.5" fill="#4A3220" font-weight="500">Assise damée</text><rect x="22" y="144" width="172" height="34" fill="#B89060"/><line x1="22" y1="152" x2="194" y2="152" stroke="rgba(122,79,46,0.18)" stroke-width=".8" stroke-dasharray="4,3"/><line x1="22" y1="162" x2="194" y2="162" stroke="rgba(122,79,46,0.18)" stroke-width=".8" stroke-dasharray="4,3"/><line x1="22" y1="170" x2="194" y2="170" stroke="rgba(122,79,46,0.18)" stroke-width=".8" stroke-dasharray="4,3"/><text x="108" y="165" text-anchor="middle" font-family="DM Sans,sans-serif" font-size="8.5" fill="#4A3220" font-weight="500">Assise damée</text><rect x="22" y="180" width="172" height="34" fill="#C4A97A"/><line x1="22" y1="188" x2="194" y2="188" stroke="rgba(122,79,46,0.18)" stroke-width=".8" stroke-dasharray="4,3"/><line x1="22" y1="198" x2="194" y2="198" stroke="rgba(122,79,46,0.18)" stroke-width=".8" stroke-dasharray="4,3"/><line x1="22" y1="206" x2="194" y2="206" stroke="rgba(122,79,46,0.18)" stroke-width=".8" stroke-dasharray="4,3"/><text x="108" y="201" text-anchor="middle" font-family="DM Sans,sans-serif" font-size="8.5" fill="#4A3220" font-weight="500">Assise damée</text><rect x="22" y="216" width="172" height="26" fill="#7A4F2E"/><text x="108" y="233" text-anchor="middle" font-family="DM Sans,sans-serif" font-size="9" fill="#F5EDD8">Soubassement pierre / béton</text><rect x="10" y="244" width="196" height="22" rx="2" fill="#4A3220"/><text x="108" y="259" text-anchor="middle" font-family="DM Sans,sans-serif" font-size="9" fill="#E8C98A">Fondation</text><line x1="5" y1="36" x2="5" y2="214" stroke="#C17F3A" stroke-width=".8"/><line x1="2" y1="36" x2="8" y2="36" stroke="#C17F3A" stroke-width=".8"/><line x1="2" y1="214" x2="8" y2="214" stroke="#C17F3A" stroke-width=".8"/><text x="3" y="130" text-anchor="middle" font-family="DM Sans,sans-serif" font-size="7.5" fill="#C17F3A" transform="rotate(-90,3,130)">50–70 cm</text><line x1="200" y1="36" x2="200" y2="70" stroke="#C17F3A" stroke-width=".8"/><line x1="197" y1="36" x2="203" y2="36" stroke="#C17F3A" stroke-width=".8"/><line x1="197" y1="70" x2="203" y2="70" stroke="#C17F3A" stroke-width=".8"/><text x="211" y="57" text-anchor="middle" font-family="DM Sans,sans-serif" font-size="7" fill="#C17F3A" transform="rotate(90,211,57)">~25 cm</text><rect x="22" y="36" width="172" height="178" fill="none" stroke="rgba(122,79,46,0.3)" stroke-width="1"/></svg>
    <div class="mur-legende">
      <div class="legende-row"><div class="ldot" style="background:#9E7B55"></div><div><strong>Solin de tête</strong><span>Protège le mur des eaux de ruissellement. La devise : « bonnes bottes, bon chapeau. »</span></div></div>
      <div class="legende-row"><div class="ldot" style="background:#C4A97A;border:.5px solid rgba(122,79,46,0.3)"></div><div><strong>Assises de pisé damé</strong><span>Terre + graviers compactés couche par couche (20–25 cm) dans des banches bois démontables.</span></div></div>
      <div class="legende-row"><div class="ldot" style="background:rgba(200,180,140,0.5);border:.5px solid rgba(122,79,46,0.3)"></div><div><strong>Joints de reprise</strong><span>Lignes de liaison entre chaque passe. Invisibles après séchage.</span></div></div>
      <div class="legende-row"><div class="ldot" style="background:#7A4F2E"></div><div><strong>Soubassement</strong><span>Pierre ou béton, isole le mur de terre de la remontée capillaire.</span></div></div>
      <div class="legende-row"><div class="ldot" style="background:#4A3220"></div><div><strong>Fondation</strong><span>Assise portante ancrée dans le sol.</span></div></div>
    </div>
  </div>

  <!-- Composition -->
  <p class="bloc-titre">Composition du mélange terre</p>
  <div class="compo-card">
    <div class="compo-bar-bg"><div class="compo-bar-fill"><div style="width:50%;background:#C4A97A"></div><div style="width:30%;background:#9E7B55"></div><div style="width:15%;background:#7A4F2E"></div><div style="width:5%;background:#A8B890"></div></div></div>
    <div class="compo-legend">
      <span><i style="background:#C4A97A"></i>Sables &amp; limons — 50%</span>
      <span><i style="background:#9E7B55"></i>Graviers — 30%</span>
      <span><i style="background:#7A4F2E"></i>Argile — 15%</span>
      <span><i style="background:#A8B890"></i>Humidité — 5%</span>
    </div>
    <p class="compo-note">Terre prélevée <strong>sur site ou à proximité</strong>. Granulométrie vérifiée avant chantier. Aucun liant chimique — l'argile joue le rôle de colle naturelle.</p>
  </div>

  <!-- Processus -->
  <p class="bloc-titre">Les 5 étapes de construction</p>
  <div class="process-row">
    <div class="process-step"><div class="snum">01</div><div class="slabel">Analyse<br>de la terre</div><p>Test granulométrique et teneur en argile.</p><span class="sarrow">›</span></div>
    <div class="process-step"><div class="snum">02</div><div class="slabel">Pose<br>du coffrage</div><p>Banches montées sur l'assise précédente.</p><span class="sarrow">›</span></div>
    <div class="process-step"><div class="snum">03</div><div class="slabel">Damage<br>de la terre</div><p>Couches de 15 cm damées au pilon à refus.</p><span class="sarrow">›</span></div>
    <div class="process-step"><div class="snum">04</div><div class="slabel">Décoffrage<br>et montée</div><p>50–70 cm de montée par jour selon météo.</p><span class="sarrow">›</span></div>
    <div class="process-step"><div class="snum">05</div><div class="slabel">Séchage<br>naturel</div><p>Plusieurs semaines à l'air — résistance croissante.</p></div>
  </div>

  <!-- Propriétés -->
  <p class="bloc-titre">Performances du matériau</p>
  <div class="props-grid">
    <div class="prop-card"><div class="picon">🌡️</div><strong>Inertie thermique</strong><p>Déphasage 8–12h — fraîcheur l'été, chaleur l'hiver</p></div>
    <div class="prop-card"><div class="picon">💧</div><strong>Hygrométrie</strong><p>Régule naturellement l'humidité ambiante</p></div>
    <div class="prop-card"><div class="picon">♻️</div><strong>Zéro CO₂</strong><p>Aucune cuisson, aucun liant — bilan carbone quasi nul</p></div>
    <div class="prop-card"><div class="picon">⏳</div><strong>&gt; 500 ans</strong><p>Durabilité prouvée, si protégé de l'eau</p></div>
  </div>
</section>

<!-- RÉALISATIONS -->
{realisations.length > 0 && (
<section class="real-section">
  <div class="section-header">
    <div><span class="section-eyebrow">Galerie</span><h2 class="section-title">Réalisations récentes</h2></div>
    <a href={`${base}/realisations`} class="section-link">Toutes les réalisations →</a>
  </div>
  <div class="real-grid">
    {realisations.map((r, i) => (
      <a href={`${base}/realisations/${r.slug}`} class={`real-card ${i === 0 ? 'real-main' : 'real-small'}`}>
        {r.data.image
          ? <img src={r.data.image} alt={r.data.title} />
          : <div class="real-placeholder"></div>}
        <div class="real-overlay">
          <p class="real-tag">{r.data.type} · {r.data.location}</p>
          <p class="real-name">{r.data.title}</p>
        </div>
      </a>
    ))}
  </div>
</section>
)}

<!-- ASSOCIATIONS -->
{associations.length > 0 && (
<section class="asso-section">
  <div class="section-header">
    <div><span class="section-eyebrow">Territoire</span><h2 class="section-title">Associations engagées</h2></div>
    <a href={`${base}/associations`} class="section-link">Toutes les associations →</a>
  </div>
  <div class="asso-grid">
    {associations.map(a => (
      <div class="asso-card">
        <div class="asso-header">
          <div class="asso-logo">{a.data.sigle}</div>
          <div><p class="asso-name">{a.data.title}</p><span class="asso-type">{a.data.type}</span></div>
        </div>
        <div class="asso-body">
          {a.data.address && <div class="asso-row">📍 <span>{a.data.address}</span></div>}
          {a.data.phone && <div class="asso-row">📞 <span>{a.data.phone}</span></div>}
          {a.data.email && <div class="asso-row">✉️ <a href={`mailto:${a.data.email}`}>{a.data.email}</a></div>}
          {a.data.website && <div class="asso-row">🌐 <a href={a.data.website} target="_blank" rel="noopener">{a.data.website.replace(/^https?:\/\//, '')}</a></div>}
        </div>
        <div class="asso-footer">
          <span class="asso-zone">📍 {a.data.zone}</span>
          <a href={`${base}/associations/${a.slug}`} class="asso-cta">Fiche complète →</a>
        </div>
      </div>
    ))}
  </div>
</section>
)}

<!-- AGENDA -->
{agenda.length > 0 && (
<section class="agenda-section">
  <div class="section-header">
    <div><span class="section-eyebrow" style="color:var(--ocre-light)">Agenda</span><h2 class="section-title" style="color:var(--lin)">Prochains événements</h2></div>
    <a href={`${base}/agenda`} class="section-link" style="color:rgba(247,242,232,0.45);border-color:rgba(247,242,232,0.2)">Tout l'agenda →</a>
  </div>
  <div class="events-list">
    {agenda.map(e => {
      const d = new Date(e.data.date);
      return (
        <a href={`${base}/agenda/${e.slug}`} class="event-card">
          <div class="edate">
            <span class="eday">{d.getDate().toString().padStart(2,'0')}</span>
            <span class="emonth">{d.toLocaleDateString('fr-FR',{month:'short'})}</span>
          </div>
          <div class="edivider"></div>
          <div class="einfo">
            <p class="etitle">{e.data.title}</p>
            <div class="emeta"><span>📍 {e.data.location}</span><span>⏱ {e.data.duration}</span></div>
          </div>
          <span class="etype">{e.data.type}</span>
        </a>
      );
    })}
  </div>
</section>
)}

</BaseLayout>

<style>
  /* HERO */
  .hero { display:grid;grid-template-columns:1fr 1fr;min-height:92vh;align-items:stretch; }
  .hero-text { display:flex;flex-direction:column;justify-content:center;padding:5rem 3.5rem 5rem 3rem; }
  .eyebrow { display:inline-flex;align-items:center;gap:.5rem;font-size:.68rem;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:var(--ocre);margin-bottom:1.5rem; }
  .eyebrow-line { width:2rem;height:1px;background:var(--ocre-light); }
  .hero-title { font-family:'Playfair Display',serif;font-size:clamp(2.6rem,4vw,4rem);font-weight:600;line-height:1.08;color:var(--charbon);margin-bottom:.5rem; }
  .hero-title em { font-style:italic;color:var(--ocre); }
  .hero-subtitle { font-family:'Source Serif 4',serif;font-size:1.05rem;font-weight:300;line-height:1.75;color:var(--argile);margin:1rem 0 2.5rem;max-width:40ch; }
  .hero-actions { display:flex;align-items:center;gap:1.5rem; }
  .btn-icon { width:1.6rem;height:1.6rem;border-radius:50%;background:rgba(247,242,232,0.2);display:flex;align-items:center;justify-content:center;font-size:.85rem; }
  .hero-stats { display:flex;gap:2.5rem;margin-top:3rem;padding-top:2rem;border-top:1px solid rgba(193,127,58,0.2); }
  .stat-num { font-family:'Playfair Display',serif;font-size:1.9rem;font-weight:600;color:var(--terre);display:block;line-height:1.1; }
  .stat-label { font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--argile);margin-top:.15rem;display:block; }
  .hero-visual { position:relative;overflow:hidden; }
  .hero-img { width:100%;height:100%;object-fit:cover;display:block; }
  .hero-overlay { position:absolute;inset:0;background:linear-gradient(to right,rgba(247,242,232,0.12) 0%,transparent 40%); }
  .hero-badge { position:absolute;bottom:2.5rem;left:2rem;background:rgba(247,242,232,0.96);border:1px solid rgba(193,127,58,0.3);border-radius:1rem;padding:1rem 1.25rem; }
  .badge-num { font-family:'Playfair Display',serif;font-size:1.4rem;font-weight:600;color:var(--terre);display:block;line-height:1.1; }
  .badge-text { font-size:.65rem;letter-spacing:.12em;text-transform:uppercase;color:var(--argile);margin-top:.2rem;display:block; }
  /* INTRO BAND */
  .intro-band { background:var(--terre);padding:2.5rem 3rem;display:flex;align-items:center;gap:3rem; }
  .intro-quote { font-family:'Source Serif 4',serif;font-size:1.05rem;font-weight:300;font-style:italic;color:var(--ocre-light);flex:1;line-height:1.65; }
  .intro-divider { width:1px;height:3rem;background:rgba(193,127,58,0.35);flex-shrink:0; }
  .intro-text { font-size:.82rem;color:rgba(247,242,232,0.65);line-height:1.75;flex:2;font-weight:300; }
  /* SCHÉMA */
  .schema-section { background:#EDE4D0;padding:5rem 3rem; }
  .bloc-titre { font-size:.65rem;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--ocre);margin-bottom:1.1rem;margin-top:2.75rem; }
  .bloc-titre:first-of-type { margin-top:0; }
  .mur-wrapper { display:flex;gap:2.5rem;align-items:flex-start;margin-bottom:0; }
  .mur-legende { display:flex;flex-direction:column;gap:.9rem;padding-top:.5rem; }
  .legende-row { display:flex;align-items:flex-start;gap:.75rem; }
  .ldot { width:.85rem;height:.85rem;border-radius:.2rem;flex-shrink:0;margin-top:.18rem; }
  .legende-row strong { font-weight:500;display:block;font-size:.82rem;color:var(--charbon); }
  .legende-row span { font-size:.74rem;color:var(--argile);font-weight:300;line-height:1.55; }
  .compo-card { background:white;border:.5px solid rgba(193,127,58,0.2);border-radius:.85rem;padding:1.35rem 1.5rem; }
  .compo-bar-bg { background:#EDE4D0;border-radius:2rem;height:.9rem;overflow:hidden;margin-bottom:.6rem; }
  .compo-bar-fill { height:100%;border-radius:2rem;display:flex;overflow:hidden; }
  .compo-bar-fill div { height:100%; }
  .compo-legend { display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;margin-top:.75rem; }
  .compo-legend span { display:flex;align-items:center;gap:.45rem;font-size:.76rem;color:var(--charbon); }
  .compo-legend i { display:inline-block;width:.7rem;height:.7rem;border-radius:.15rem;flex-shrink:0;font-style:normal; }
  .compo-note { font-size:.73rem;color:var(--argile);margin-top:.85rem;font-weight:300;line-height:1.65;border-top:.5px solid rgba(193,127,58,0.15);padding-top:.75rem; }
  .process-row { display:flex;align-items:stretch; }
  .process-step { flex:1;background:white;border:.5px solid rgba(193,127,58,0.2);padding:1.15rem 1rem;position:relative; }
  .process-step:first-child { border-radius:.75rem 0 0 .75rem; }
  .process-step:last-child { border-radius:0 .75rem .75rem 0; }
  .process-step+.process-step { border-left:none; }
  .snum { font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:600;color:var(--ocre-light);line-height:1;margin-bottom:.45rem; }
  .slabel { font-size:.82rem;font-weight:500;color:var(--terre);margin-bottom:.3rem;line-height:1.3; }
  .process-step p { font-size:.72rem;color:var(--argile);line-height:1.55;font-weight:300; }
  .sarrow { position:absolute;right:-.72rem;top:50%;transform:translateY(-50%);width:1.4rem;height:1.4rem;background:var(--ocre-pale);border:.5px solid rgba(193,127,58,0.35);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.8rem;color:var(--ocre);z-index:2;line-height:1; }
  .props-grid { display:grid;grid-template-columns:repeat(4,1fr);gap:.9rem; }
  .prop-card { background:white;border:.5px solid rgba(193,127,58,0.2);border-radius:.85rem;padding:1.2rem 1rem;text-align:center; }
  .picon { font-size:1.4rem;margin-bottom:.4rem; }
  .prop-card strong { font-family:'Playfair Display',serif;font-size:.95rem;font-weight:600;color:var(--terre);display:block;margin-bottom:.25rem; }
  .prop-card p { font-size:.7rem;color:var(--argile);line-height:1.5;font-weight:300; }
  /* RÉALISATIONS */
  .real-section { background:#F0E8D5;padding:5rem 3rem; }
