---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const acteurs = await getCollection('acteurs');
const avecCoords = acteurs.filter(a => a.data.lat && a.data.lng);

const markersJson = JSON.stringify(avecCoords.map(a => ({
  title: a.data.title,
  role: a.data.role,
  zone: a.data.zone,
  phone: a.data.phone ?? null,
  email: a.data.email ?? null,
  website: a.data.website ?? null,
  slug: a.slug,
  lat: a.data.lat,
  lng: a.data.lng,
})));

const roles = [...new Set(acteurs.map(a => a.data.role))].sort();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Carte des acteurs" description="Carte interactive des artisans et professionnels du pisé en Isère">

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />

<div class="carte-page">
  <div class="carte-header section">
    <div>
      <span class="section-eyebrow">Territoire</span>
      <h1 class="section-title">Carte des acteurs du pisé</h1>
      <p class="carte-desc">Artisans, architectes et formateurs spécialisés en construction de terre crue dans le département de l'Isère (38).</p>
    </div>
    <div class="carte-filters">
      <button class="filter-btn active" data-role="tous">Tous</button>
      {roles.map(role => (
        <button class="filter-btn" data-role={role}>{role}</button>
      ))}
    </div>
  </div>

  <div class="carte-layout">
    <div id="map"></div>
    <aside class="carte-sidebar">
      <p class="sidebar-hint" id="sidebar-hint">Cliquez sur un marqueur pour voir la fiche de l'acteur.</p>
      <div id="sidebar-content"></div>
    </aside>
  </div>

  {avecCoords.length === 0 && (
    <div class="carte-empty section">
      <p>Aucun acteur géolocalisé pour l'instant. Ajoutez des coordonnées GPS dans les fiches acteurs via le back-office.</p>
      <a href={`${base}/acteurs`} class="btn-primary" style="margin-top:1.5rem">Voir l'annuaire</a>
    </div>
  )}
</div>

<!-- Données serveur encodées dans le HTML -->
<script id="map-data" type="application/json" data-base={base}>{markersJson}</script>

<script is:inline>
  (function () {
    var ROLE_COLORS = {
      'Maçon pisé':         '#C17F3A',
      'Architecte terre':   '#7A4F2E',
      'Entreprise générale':'#5C7A5A',
      'Formateur':          '#4A6B8A',
      "Bureau d'études":    '#8A5A8A',
      'Autre':              '#9E7B55',
    };

    function colorForRole(r) { return ROLE_COLORS[r] || '#9E7B55'; }

    function makeIcon(role) {
      var c = colorForRole(role);
      var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="38" viewBox="0 0 28 38">'
        + '<path d="M14 0C6.27 0 0 6.27 0 14c0 9.63 14 24 14 24S28 23.63 28 14C28 6.27 21.73 0 14 0z" fill="' + c + '" stroke="white" stroke-width="2"/>'
        + '<circle cx="14" cy="14" r="5" fill="white" opacity="0.9"/></svg>';
      return L.icon({
        iconUrl: 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(svg))),
        iconSize: [28, 38], iconAnchor: [14, 38], popupAnchor: [0, -38],
      });
    }

    function initMap() {
      var el = document.getElementById('map-data');
      var MARKERS = JSON.parse(el.textContent);
      var base = el.getAttribute('data-base');

      var map = L.map('map').setView([45.188, 5.724], 9);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© <a href="https://openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 18,
      }).addTo(map);

      var lMarkers = [];

      MARKERS.forEach(function (m) {
        var mk = L.marker([m.lat, m.lng], { icon: makeIcon(m.role) });
        mk.bindPopup(
          '<div class="popup-card">'
          + '<div class="popup-role" style="background:' + colorForRole(m.role) + '">' + m.role + '</div>'
          + '<strong class="popup-name">' + m.title + '</strong>'
          + '<span class="popup-zone">📍 ' + m.zone + '</span>'
          + (m.phone  ? '<a href="tel:'    + m.phone   + '" class="popup-link">📞 ' + m.phone  + '</a>' : '')
          + (m.email  ? '<a href="mailto:' + m.email   + '" class="popup-link">✉ '  + m.email  + '</a>' : '')
          + (m.website? '<a href="'        + m.website + '" target="_blank" rel="noopener" class="popup-link">🌐 Site web</a>' : '')
          + '<a href="' + base + '/acteurs/' + m.slug + '" class="popup-cta">Voir la fiche →</a>'
          + '</div>',
          { maxWidth: 240 }
        );
        mk.on('click', function () {
          document.getElementById('sidebar-hint').style.display = 'none';
          document.getElementById('sidebar-content').innerHTML =
            '<div class="sb-card">'
            + '<span class="sb-role" style="background:' + colorForRole(m.role) + '">' + m.role + '</span>'
            + '<h3 class="sb-name">' + m.title + '</h3>'
            + '<p class="sb-zone">📍 ' + m.zone + '</p>'
            + (m.phone  ? '<a href="tel:'    + m.phone   + '" class="sb-link">📞 ' + m.phone  + '</a>' : '')
            + (m.email  ? '<a href="mailto:' + m.email   + '" class="sb-link">✉ '  + m.email  + '</a>' : '')
            + (m.website? '<a href="'        + m.website + '" target="_blank" rel="noopener" class="sb-link">🌐 Site web</a>' : '')
            + '<a href="' + base + '/acteurs/' + m.slug + '" class="btn-primary sb-cta">Voir la fiche complète</a>'
            + '</div>';
        });
        mk.markerRole = m.role;
        mk.addTo(map);
        lMarkers.push(mk);
      });

      document.querySelectorAll('.filter-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          document.querySelectorAll('.filter-btn').forEach(function (b) { b.classList.remove('active'); });
          btn.classList.add('active');
          var role = btn.getAttribute('data-role');
          lMarkers.forEach(function (mk) {
            if (role === 'tous' || mk.markerRole === role) mk.addTo(map); else mk.remove();
          });
        });
      });
    }

    /* Chargement dynamique de Leaflet — garantit que L est disponible avant initMap */
    var css = document.createElement('link');
    css.rel = 'stylesheet';
    css.href = 'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css';
    document.head.appendChild(css);

    var js = document.createElement('script');
    js.src = 'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js';
    js.onload = initMap;
    document.head.appendChild(js);
  })();
</script>

</BaseLayout>

<style>
  .carte-page { display:flex;flex-direction:column; }
  .carte-header { display:flex;justify-content:space-between;align-items:flex-start;gap:2rem;flex-wrap:wrap;padding-bottom:1.5rem; }
  .carte-desc { font-size:.9rem;color:var(--argile);margin-top:.75rem;max-width:52ch;line-height:1.7; }
  .carte-filters { display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin-top:.5rem; }
  .filter-btn { font-size:.72rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;padding:.4rem 1rem;border-radius:2rem;border:1px solid var(--mur);background:transparent;color:var(--argile);cursor:pointer;transition:all .2s; }
  .filter-btn:hover { border-color:var(--ocre);color:var(--terre); }
  .filter-btn.active { background:var(--terre);color:var(--lin);border-color:var(--terre); }
  .carte-layout { display:grid;grid-template-columns:1fr 280px;height:580px; }
  #map { width:100%;height:100%;z-index:1; }
  .carte-sidebar { background:var(--lin);border-left:1px solid var(--mur);overflow-y:auto;padding:1.25rem; }
  .sidebar-hint { font-size:.78rem;color:var(--argile);line-height:1.6;font-style:italic; }
  .sb-card { display:flex;flex-direction:column;gap:.6rem; }
  .sb-role { font-size:.65rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#fff;padding:.25rem .65rem;border-radius:2rem;align-self:flex-start; }
  .sb-name { font-family:'Playfair Display',serif;font-size:1.1rem;color:var(--charbon);line-height:1.3; }
  .sb-zone { font-size:.8rem;color:var(--argile); }
  .sb-link { font-size:.8rem;color:var(--terre);text-decoration:none;display:block; }
  .sb-link:hover { color:var(--ocre); }
  .sb-cta { margin-top:.75rem;font-size:.72rem;padding:.65rem 1.2rem; }
  .carte-empty { text-align:center;color:var(--argile);font-size:.9rem; }
  :global(.popup-card) { display:flex;flex-direction:column;gap:.4rem;min-width:160px; }
  :global(.popup-role) { font-size:.6rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#fff;padding:.2rem .5rem;border-radius:2rem;align-self:flex-start; }
  :global(.popup-name) { font-family:'Playfair Display',serif;font-size:.95rem;color:var(--charbon); }
  :global(.popup-zone) { font-size:.75rem;color:var(--argile); }
  :global(.popup-link) { font-size:.75rem;color:var(--terre);text-decoration:none; }
  :global(.popup-cta) { font-size:.7rem;font-weight:600;color:var(--ocre);text-decoration:none;margin-top:.25rem; }
  :global(.leaflet-popup-content-wrapper) { border-radius:8px;box-shadow:0 4px 20px rgba(44,36,24,.15); }
  @media(max-width:768px) {
    .carte-layout { grid-template-columns:1fr;height:auto; }
    #map { height:420px; }
    .carte-sidebar { height:220px; }
    .carte-header { flex-direction:column; }
  }
</style>
